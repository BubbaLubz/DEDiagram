# Copy to .env and fill in values before running

# Anthropic (required for AI generation)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub OAuth — create at github.com/settings/applications/new
# Authorization callback URL: http://localhost:3001/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — create at console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session (generate a random string, e.g. openssl rand -hex 32)
SESSION_SECRET=change-this-to-a-random-string

# URLs (defaults work for local dev — update for production)
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:3001
